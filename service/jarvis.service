# Linux: run Jarvis in the background at login.
#
#   mkdir -p ~/.config/systemd/user
#   cp service/jarvis.service ~/.config/systemd/user/
#   # edit WorkingDirectory + the API key line below
#   systemctl --user daemon-reload
#   systemctl --user enable --now jarvis
#   journalctl --user -u jarvis -f          # watch the logs
#
# So it keeps running when you're not logged in:
#   sudo loginctl enable-linger $USER

[Unit]
Description=Jarvis voice assistant
After=sound.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jarvis
Environment=PYTHONUNBUFFERED=1
# Either set the key here or point to a file with EnvironmentFile.
EnvironmentFile=-%h/.jarvis/env
ExecStart=%h/jarvis/.venv/bin/python -m jarvis
Restart=always
RestartSec=5
# Audio needs the user session's PulseAudio/PipeWire socket.
Environment=XDG_RUNTIME_DIR=/run/user/%U
# Light hardening — it only needs the mic, the speakers and ~/.jarvis
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.jarvis

[Install]
WantedBy=default.target
